{
  "name": "jcgpl",
  "displayName": "flutter-clean-generator",
  "description": "Generate Flutter Clean Architecture boilerplate",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "flutter-clean.generateFeature",
        "title": "Flutter Clean: Generate Feature"
      },
      {
        "command": "flutter-clean.generateCore",
        "title": "Flutter Clean: Initialize Core Architecture"
      },
      {
        "command": "flutter-architect.generateConfig",
        "title": "Flutter Architect: Generate Config"
      },
      {
        "command": "flutter-architect.initializeProject",
        "title": "Flutter Architect: Initialize Project"
      },
      {
        "command": "flutter-architect.generateProjectSnapshot",
        "title": "Flutter Architect: Export Project Snapshot"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "flutter-architect.initializeProject",
          "group": "navigation"
        },
        {
          "command": "flutter-clean.generateCore",
          "group": "flutter_clean@1",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "flutter-clean.generateFeature",
          "group": "navigation",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "flutter-architect.generateProjectSnapshot",
          "group": "navigation"
        }
      ]
    },
    "activationEvents": [
      "onCommand:flutter-architect.initializeProject"
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}